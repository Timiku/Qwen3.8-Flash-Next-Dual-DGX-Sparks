# Alert on supervisor unit failure (plan 1.5): systemd OnFailure= target that
# posts an alert. Installed alongside qwen38-flash-supervisor.service.
[Unit]
Description=Alert on Qwen3.8-Flash-Next supervisor failure

[Service]
Type=oneshot
WorkingDirectory=%h/Qwen3.8-Flash-Next-Dual-DGX-Sparks
ExecStart=%h/Qwen3.8-Flash-Next-Dual-DGX-Sparks/scripts/alert.sh "SUPERVISOR UNIT FAILED: %i"
